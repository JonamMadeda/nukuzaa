{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nukuzaa",
  "version": "0.2.0",
  "identifier": "com.nukuzaa.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Nukuzaa",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/JonamMadeda/nukuzaa/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUwQjE3NDQwMTg2NEM0MgpSV1JDVElZQlJCY0xCUVRhYjd1eVlQcUk1YkJNUzVUbTcvNHhVSHQ3dTdrOXk4dFU2emw3Y3FXaAo="
    }
  }
}
