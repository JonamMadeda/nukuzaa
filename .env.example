# Copy to `.env` and fill in the values below, then run `node scripts/migrate.mjs`
# (it auto-generates APP_DB_PASSWORD + VITE_DATABASE_AUTHENTICATED_URL).
# WARNING: never commit a real `.env` containing secrets.

# Owner pooled connection (migrations/admin only — never shipped to users).
# Get it from: Neon Console → your project → Connect → pooled connection.
VITE_DATABASE_URL=postgresql://neondb_owner:***@ep-***-pooler.c-2.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon Auth (Better Auth) base URL — public identifier, safe to share.
# Get it from: Neon Console → your project → Auth.
VITE_NEON_AUTH_URL=https://ep-***.neonauth.c-2.us-east-2.aws.neon.tech/neondb/auth

# JWKS used to verify the auth JWTs before scoping DB queries.
VITE_NEON_JWKS_URL=https://ep-***.neonauth.c-2.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json

# OpenRouter (video summaries) — free tier, no credit card.
# Get a key at https://openrouter.ai/keys and put it here (`.env` is gitignored).
# Model default: nvidia/nemotron-3-ultra-550b-a55b:free (1M ctx) with fallbacks.
# Override the model with VITE_OPENROUTER_MODEL if OpenRouter's free list changes.
VITE_OPENROUTER_API_KEY=sk-or-v1-***
# VITE_OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Summary proxy (preferred for releases): the shared OpenRouter key lives
# server-side as a Worker secret — see proxy/README.md. Public URL, safe to
# share. When set, the app never needs a client-side key.
# VITE_SUMMARY_PROXY_URL=https://nukuzaa-summary-proxy.<you>.workers.dev
